#!/usr/bin/env bash
# forja — CodeCrafters-shaped front door for the Anyformat prep track.
#
#   forja track                         AWS → infra → LLM → evals → agents
#   forja smoke aws-from-scratch        stage 0: is the course runnable?
#   forja guide aws-from-scratch 1      one stage page (mechanism → tests)
#   forja test aws-from-scratch --stage 1
#   forja export llm-from-scratch /tmp/llm-starter
#   forja guides --write                regenerate START.md + stages/
#
# Everything else forwards to codecraft (same as `cz`).

set -eu

self="$(readlink -f "${BASH_SOURCE[0]}")"
root="$(cd "$(dirname "$self")" && pwd)"

if [ "$#" -eq 0 ]; then
  set -- track
fi

exec python3 "$root/codecraft/cli.py" "$@"
