#!/usr/bin/env bash
# cz — the short front door for codecraft.
#
#   cz                      your learning board
#   cz path                 the ordered plan, with progress
#   cz dag [<course>]       the dependency DAG: what must come first
#   cz tracks [<course>]    the same graph as tracks: what each row ends
#   cz brief [<course>]     how to author a row: the rules, the reading, the bar
#   cz run aws-from-scratch run a course; read the nudge
#   cz run aws-from-scratch --stage 3  one stage, not all of them
#   cz stage aws-from-scratch 3  one stage: what to write, what it costs
#   cz hint aws-from-scratch  a bigger nudge
#   cz ask "..." aws-from-scratch   ask the mentor
#
# This is a forwarding shim; every subcommand of codecraft/cli.py works.

set -eu

self="$(readlink -f "${BASH_SOURCE[0]}")"
root="$(cd "$(dirname "$self")" && pwd)"

exec python3 "$root/codecraft/cli.py" "$@"
